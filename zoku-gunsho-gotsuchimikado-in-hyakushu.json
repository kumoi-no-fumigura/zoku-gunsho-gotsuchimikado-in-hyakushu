   "side": "",
   "dai": "梅風",
   "kotobagaki": ""
  },
  {
   "seq": "12",
   "text": "露むすふ柳点かけの川の瀬になひく玉もゝみたれあひつゝ",
   "kana": "",
   "speaker": "",
   "page": 2,
   "pid": "nao-733738",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "柳露",
   "kotobagaki": ""
  },
  {
   "seq": "13",
   "text": "一霞さへよそめへてふるをともしのふの岩春雨のそら",
   "kana": "",
   "speaker": "",
   "page": 2,
   "pid": "nao-733738",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "春雨",
   "kotobagaki": ""
  },
  {
   "seq": "14",
   "text": "帰行声あまたの天津かりかすは露に見えわかねとも",
   "kana": "",
   "speaker": "",
   "page": 2,
   "pid": "nao-733738",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "帰雁述",
   "kotobagaki": ""
  },
  {
   "seq": "15",
   "text": "としや只かたわれ月の折しもあれ残のかけの友をそ霞める",
   "kana": "",
   "speaker": "",
   "page": 2,
   "pid": "nao-733738",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "春月",
   "kotobagaki": ""
  },
  {
   "seq": "16",
   "text": "匂はまは珍しきれき雲とのみまかひや果ん崩のはつ花",
   "kana": "",
   "speaker": "",
   "page": 2,
   "pid": "nao-733738",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "寄雲花",
   "kotobagaki": ""
  },
  {
   "seq": "17",
   "text": "風をこそいとひし物を霞さへつらき名にたつ山桜かな",
   "kana": "",
   "speaker": "",
   "page": 2,
   "pid": "nao-733738",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "霞隔花",
   "kotobagaki": ""
  },
  {
   "seq": "18",
   "text": "春雨のあすかへふらはいかゝせんやゝしほれ行音の夕暮",
   "kana": "",
   "speaker": "",
   "page": 2,
   "pid": "nao-733738",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "雨中花",
   "kotobagaki": ""
  },
  {
   "seq": "19",
   "text": "〽かきりありてちるたにうきを春風のいかにせよとて花に吹らん",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-733738",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "風前花",
   "kotobagaki": ""
  },
  {
   "seq": "20",
   "text": "〽春の日に消ぬはかりそはなさくらちるもちらぬも雪の面かけ",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-733738",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "花如疱",
   "kotobagaki": ""
  },
  {
   "seq": "21",
   "text": "みつしほをいとひやすらん湊田のなはしろ水はかくれとも",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-733738",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "苗代",
   "kotobagaki": ""
  },
  {
   "seq": "22",
   "text": "水底にきらの山吹うつり来て砂のこかねを散かとそみる",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-733738",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "岸款冬",
   "kotobagaki": ""
  },
  {
   "seq": "23",
   "text": "一春をへてよるね浪も藤なみも木高き松の上にこそみれ",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-733738",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "松藤",
   "kotobagaki": ""
  },
  {
   "seq": "24",
   "text": "暁は夏とやつそん夕万くれ春のかきりの入相のかね",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-733738",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "三月尽",
   "kotobagaki": ""
  },
  {
   "seq": "25",
   "text": "〽たちかえて薄き衣に夏のくる今朝は中〳〵風そ寒けれ",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-733738",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "十五首夏更衣",
   "kotobagaki": ""
  },
  {
   "seq": "26",
   "text": "岸をこすなみかたみゆる卯花のうつらふかけもみえぬ下水",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-733738",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "河夘図",
   "kotobagaki": ""
  },
  {
   "seq": "27",
   "text": "人伝に聞もならはぬ比をこそ初音は八しれ山本とゝきす",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-733738",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "初郭公",
   "kotobagaki": ""
  },
  {
   "seq": "28",
   "text": "誰里もおほし心に聞つらん今宵の月になくほときす",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-733738",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "郭公遍",
   "kotobagaki": ""
  },
  {
   "seq": "29",
   "text": "あれに遣り志賀の都の昔をも花橘の香にや残さん",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-733738",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "慮橋",
   "kotobagaki": ""
  },
  {
   "seq": "30",
   "text": "〽わか宿の軒にかりふくあやめ草いつれの沼に根を残すら",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-733738",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "答菖蒲",
   "kotobagaki": ""
  },
  {
   "seq": "31",
   "text": "〽種まきてそはた賤か哀てふとをあましたにとるさなへかな",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-733738",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "早苗",
   "kotobagaki": ""
  },
  {
   "seq": "32",
   "text": "けふいゝか天忠岩戸も雲とちて神代覚後五月雨のころ",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-733738",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "五月雨",
   "kotobagaki": ""
  },
  {
   "seq": "33",
   "text": "たしてねに誰明すらんまし宵と起るゝておもふ短夜の月",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-733738",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "夏自",
   "kotobagaki": ""
  },
  {
   "seq": "34",
   "text": "夏木立ひとつ縁に大あらき光杜の下草しせりそひつゝ",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-733738",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "夏草滋",
   "kotobagaki": ""
  },
  {
   "seq": "35",
   "text": "隣まてかゆりみそ成ほともなき俄か伏屋にうつる煙りは",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-733738",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "牧遣火",
   "kotobagaki": ""
  },
  {
   "seq": "36",
   "text": "我心くらきにつけて窓のうちに蛍あつむる人そ嬉しき",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-733738",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "窓蛍",
   "kotobagaki": ""
  },
  {
   "seq": "37",
   "text": "時神の音は高雄の山なからあしこの嶺にかゝる夕な",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-733738",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "夕立",
   "kotobagaki": ""
  },
  {
   "seq": "38",
   "text": "つくはねのいつくかわきて涼しやと木本毎に舎りかへつゝ",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-733738",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "納涼",
   "kotobagaki": ""
  },
  {
   "seq": "39",
   "text": "御祓して遣ふより夏の渕は瀬にかはるも涼しあすか川風",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-733738",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "六月祓",
   "kotobagaki": ""
  },
  {
   "seq": "40",
   "text": "いつのまに秋は吹らん明るまてさしも侍れし風の音つれ",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-733738",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "二十首早秋",
   "kotobagaki": ""
  },
  {
   "seq": "41",
   "text": "一偽をしらぬ契やたなはたのまとなからも嬉しかならん",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-733738",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "七夕契",
   "kotobagaki": ""
  },
  {
   "seq": "42",
   "text": "〽萩の葉にむすほられてや秋風のさ松も半の美さそふらん",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-733738",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "深本萩",
   "kotobagaki": ""
  },
  {
   "seq": "43",
   "text": "をり分る錦とそ見るしらなみの花にまかわぬまのゝとし萩",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-733738",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "水辺萩",
   "kotobagaki": ""
  },
  {
   "seq": "44",
   "text": "〽打出す袖口なれや玉たれのこすの大野になひく尾馬は",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-733738",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "薄似袖",
   "kotobagaki": ""
  },
  {
   "seq": "45",
   "text": "秋寒きあさちかはらに鳴虫の命かけたる露もいつまて",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-733738",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "原虫",
   "kotobagaki": ""
  },
  {
   "seq": "46",
   "text": "なかき夜を秋ある鹿のいねかてに妻こひわひて鳴あかす也",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-733738",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "暁鹿",
   "kotobagaki": ""
  },
  {
   "seq": "47",
   "text": "ほのかにも聞ゆるそらを詠れは姿は雲の衣かりかね",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-733738",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "雲端雁",
   "kotobagaki": ""
  },
  {
   "seq": "48",
   "text": "〽しくれ行袖はことはり心なき石木も露の夕暮のあき",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-733738",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "秋夕",
   "kotobagaki": ""
  },
  {
   "seq": "49",
   "text": "旅人はさやかにも見しかすはかひかね出る秋の秋の夜の月",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-733738",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "駒迎嶺内",
   "kotobagaki": ""
  },
  {
   "seq": "50",
   "text": "夜もなを心ゆるさて起居つく月や見るめのせきの関守",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-733738",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "関月",
   "kotobagaki": ""
  },
  {
   "seq": "51",
   "text": "昼と見てねくらの鷺や驚かんゆるきの杜の月清き夜は",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-733738",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "杜月",
   "kotobagaki": ""
  },
  {
   "seq": "52",
   "text": "うきねして誰かは浪のよる毎に黒き磯部の月はみるへき",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-733738",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "磯月",
   "kotobagaki": ""
  },
  {
   "seq": "53",
   "text": "一秋の夜は月名光のあかしかし浪の千里もみゆるはかりに",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-733738",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "潟月",
   "kotobagaki": ""
  },
  {
   "seq": "54",
   "text": "なかき夜のなを残るかとたとるまて秋霧くらき朝明の空",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-733738",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "胡霧",
   "kotobagaki": ""
  },
  {
   "seq": "55",
   "text": "さゆる夜の霜にしかれす秋草の花すり衣打しきるなり",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-733738",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "擣衣",
   "kotobagaki": ""
  },
  {
   "seq": "56",
   "text": "秋はまたから紅のふり出てときはの山も色付にけり",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-733738",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "山紅葉",
   "kotobagaki": ""
  },
  {
   "seq": "57",
   "text": "岩根なる紅葉の色に染かえて錦をくれる滝の糸すち",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-733738",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "滝紅葉",
   "kotobagaki": ""
  },
  {
   "seq": "58",
   "text": "行新秋春の琵ををもふ袖の露消すは後やかしみならまし",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-733738",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "暮秋",
   "kotobagaki": ""
  },
  {
   "seq": "59",
   "text": "時雨津る雲の返し岩夕風に残ると見るも寒き日のかけ",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-733738",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "十五首時雨遇",
   "kotobagaki": ""
  },
  {
   "seq": "60",
   "text": "散りうせぬ秋の木かけもをしなへて嵐に積る山の紅葉〳〵",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-733738",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "落葉深",
   "kotobagaki": ""
  },
  {
   "seq": "61",
   "text": "見し秋に移ひかはる色なから匂ひはおなし白菊のはな",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-733738",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "残菊",
   "kotobagaki": ""
  },
  {
   "seq": "62",
   "text": "浮草の枯葉や残る瀧津瀬の氷らぬうへも霜とちてみゆ",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-733738",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "寒草霜",
   "kotobagaki": ""
  },
  {
   "seq": "63",
   "text": "牙暮すみなとの浪は残れともなを音高きひらの根あろしに",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-733738",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "湊氷",
   "kotobagaki": ""
  },
  {
   "seq": "64",
   "text": "一夫渡る雪けの空は中〳〵に嵐にくわる冬のよのつき",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-733738",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "冬月",
   "kotobagaki": ""
  },
  {
   "seq": "65",
   "text": "かれ果し跡は公なから夏川の玉江の芦の庭の池水",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-733738",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "枯茸",
   "kotobagaki": ""
  },
  {
   "seq": "66",
   "text": "ことうらの散したふへし月残るなみのこなたに千鳥鳴なり",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nao-733738",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "浦千鳥",
   "kotobagaki": ""
  },
  {
   "seq": "67",
   "text": "はなちかふ友かとみれは池水にそらとふ鷺の来つゝ馴行",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nao-733738",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "池水鳥",
   "kotobagaki": ""
  },
  {
   "seq": "68",
   "text": "ふるあられ音はかりしてたまらぬはさゝ分る朝の袖もしほれす",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nao-733738",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "篠霰",
   "kotobagaki": ""
  },
  {
   "seq": "69",
   "text": "いかに勢ん又かりゆかはふ類さの暮果ぬへき鳥の落くさ",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nao-733738",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "夕鷹狩",
   "kotobagaki": ""
  },
  {
   "seq": "70",
   "text": "一積えぬ程もわかれす白妙の庭の真砂にふれるうす雪",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nao-733738",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "里雪庭雪",
   "kotobagaki": ""
  },
  {
   "seq": "71",
   "text": "〽身のわさをなけきこりつみ寒る日に哀翁の堪て炭瓦く",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nao-733738",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "炭竃",
   "kotobagaki": ""
  },
  {
   "seq": "72",
   "text": "手ははや暮ていくたの池水に浮へるをしとおもふかひなさ",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nao-733738",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "惜威暮",
   "kotobagaki": ""
  },
  {
   "seq": "73",
   "text": "おもひ入その日よりはや逢坂の心はかよふ恋路なりけり",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nao-733738",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "二十首初恋",
   "kotobagaki": ""
  },
  {
   "seq": "74",
   "text": "もゆるとも人はいかてかしら雪の下に忍ふか原の若草",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nao-733738",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "忍恋",
   "kotobagaki": ""
  },
  {
   "seq": "75",
   "text": "恋しなん後まてもなをうき人を及はぬ枝に見てや歎かん",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "nao-733738",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "不逢恋",
   "kotobagaki": ""
  },
  {
   "seq": "76",
   "text": "解難き人の心もひたち帯かけてそ頼む神のしるへに",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "nao-733738",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "祈応",
   "kotobagaki": ""
  },
  {
   "seq": "77",
   "text": "一我さそへその名とともにもれぬへし人の行衛を人に問とて",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "nao-733738",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "尋恋",
   "kotobagaki": ""
  },
  {
   "seq": "78",
   "text": "吹風の音に聞つる人ゆへに心の花のちるもはかなし",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "nao-733738",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "聞え",
   "kotobagaki": ""
  },
  {
   "seq": "79",
   "text": "我心乱れにけり水よそなからほのみちのくの思ふもち摺",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "nao-733738",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "見惑",
   "kotobagaki": ""
  },
  {
   "seq": "80",
   "text": "一偽のある世としらはちきりをく我言の葉も人は頼まし",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "nao-733738",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "契恋",
   "kotobagaki": ""
  },
  {
   "seq": "81",
   "text": "童のめせきでまたる人もわすゝれは心にかくる夕なるらん",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "nao-733738",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "待恋",
   "kotobagaki": ""
  },
  {
   "seq": "82",
   "text": "わすれしなかりねかてらもあふみのや鏡の山のよはの面かけ",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "nao-733738",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "逢恋",
   "kotobagaki": ""
  },
  {
   "seq": "83",
   "text": "今朝はなを名残に恋しあはてたり幾並むなしく過きつる頃",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "nao-733738",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "後朝応",
   "kotobagaki": ""
  },
  {
   "seq": "84",
   "text": "忍ひしをくるしと何かおもひけん顕れぬれは猶つらき身に",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "nao-733738",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "顕応",
   "kotobagaki": ""
  },
  {
   "seq": "85",
   "text": "かねてより頼まぬ中の側にて更何と人をかこたん",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "nao-733738",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "偽恋",
   "kotobagaki": ""
  },
  {
   "seq": "86",
   "text": "つゐにかしかはるつらさを歎をとやおもはぬ中も契至せん",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "nao-733738",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "変応",
   "kotobagaki": ""
  },
  {
   "seq": "87",
   "text": "〽こくら花よそに移らふ心より年に稀なる身のちきり哉",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "nao-733738",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "稀恋",
   "kotobagaki": ""
  },
  {
   "seq": "88",
   "text": "黒髪はしろうなれともゑ初し心の筋のかはりやはする",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "nao-733738",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "久恋",
   "kotobagaki": ""
  },
  {
   "seq": "89",
   "text": "〽かけてて鐘の神のねかひても心秘さぬ中そかひなき",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "nao-733738",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "被厭恋",
   "kotobagaki": ""
  },
  {
   "seq": "90",
   "text": "はかなくもわすらるゝ身にかへるかなさてもや人のおもひおると",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "nao-733738",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "被忘恋",
   "kotobagaki": ""
  },
  {
   "seq": "91",
   "text": "いにしへのなからの橋は同々なとも能し契は又もか遣しな",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "nao-733738",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "絶恋",
   "kotobagaki": ""
  },
  {
   "seq": "92",
   "text": "数なりぬ身は童人の類ひにしかほしぬは袖師のうらみのみして",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "nao-733738",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "恨恋",
   "kotobagaki": ""
  },
  {
   "seq": "93",
   "text": "庭鳥の驚かす音にね覚して老の心をかねてしるかな",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "nao-733738",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "寝覚鶏",
   "kotobagaki": ""
  },
  {
   "seq": "94",
   "text": "古しへもたらひはあらし声なるみのゝお山の松のことの葉",
   "kana": "",
   "speaker": "",
   "page": 11,
   "pid": "nao-733738",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "名所松",
   "kotobagaki": ""
  },
  {
   "seq": "95",
   "text": "いつよりかたえぬ願むも山水も心をすます庵むすはん",
   "kana": "",
   "speaker": "",
   "page": 11,
   "pid": "nao-733738",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "山家",
   "kotobagaki": ""
  },
  {
   "seq": "96",
   "text": "冬もなをあけの細道行かよひ門田の面そ人めかれせぬ",
   "kana": "",
   "speaker": "",
   "page": 11,
   "pid": "nao-733738",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "田家",
   "kotobagaki": ""
  },
  {
   "seq": "97",
   "text": "旅衣たちかさねてもあき風の吹と吹ぬる暮そ身にしむ",
   "kana": "",
   "speaker": "",
   "page": 11,
   "pid": "nao-733738",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "羇中衣",
   "kotobagaki": ""
  },
  {
   "seq": "98",
   "text": "音高きうらはの浪のかきねにも身はならはしか夢結ふなり",
   "kana": "",
   "speaker": "",
   "page": 11,
   "pid": "nao-733738",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "旅泊夢",
   "kotobagaki": ""
  },
  {
   "seq": "99",
   "text": "〽夢現誰に問まし過きつる身の古しへのさしかならぬを",
   "kana": "",
   "speaker": "",
   "page": 11,
   "pid": "nao-733738",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "思往事",
   "kotobagaki": ""
  },
  {
   "seq": "100",
   "text": "榊ならて治めんことやかしおかの森のありしのさはかしき世を",
   "kana": "",
   "speaker": "",
   "page": 11,
   "pid": "nao-733738",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "述懐",
   "kotobagaki": ""
  },
  {
   "seq": "101",
   "text": "寵亀を我世の程のなとして為経ん数を契りをくかな",
   "kana": "",
   "speaker": "",
   "page": 11,
   "pid": "nao-733738",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "祝言",
   "kotobagaki": ""
  }
 ],
